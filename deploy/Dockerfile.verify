# ==============================================================================
# AlinkSec Verification & CI Sandbox Container
# 纯 Linux 沙盒验证容器，宿主机杀毒软件零接触、零误杀
# ==============================================================================
FROM golang:1.22-alpine

WORKDIR /app

# 替换 Alpine 国内加速源，安装基础工具 (若断网则优雅跳过，内置 /bin/sh 原生支持)
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories || true

# 预置 Go 代理加速
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0

# 拷贝代码依赖
COPY go.mod go.sum ./
RUN go mod download

# 拷贝全部源码
COPY . .

# 赋予执行权限并转换换行符 (CRLF -> LF)
RUN tr -d '\r' < scripts/verify_in_container.sh > scripts/verify_in_container_lf.sh && \
    mv scripts/verify_in_container_lf.sh scripts/verify_in_container.sh && \
    chmod +x scripts/*.sh

# 预编译全套核心组件 Linux ELF 二进制 (供容器服务与演示直接运行)
RUN mkdir -p /app/build_bin && \
    go build -o /app/build_bin/alinksec-hub ./cmd/alinksec-hub && \
    go build -o /app/build_bin/alinksec-manager ./cmd/alinksec-manager && \
    go build -o /app/build_bin/alinksec-waf ./cmd/agents/alinksec-waf && \
    go build -o /app/build_bin/alinksec-edr ./cmd/agents/alinksec-edr && \
    go build -o /app/build_bin/alinksec-tamper ./cmd/agents/alinksec-tamper && \
    go build -o /app/build_bin/alinksec-dbaudit ./cmd/agents/alinksec-dbaudit && \
    go build -o /app/build_bin/alinksec-cfw ./cmd/agents/alinksec-cfw && \
    go build -o /app/build_bin/alinksec-log ./cmd/agents/alinksec-log

# 默认运行容器内端到端全量验证
CMD ["/bin/sh", "scripts/verify_in_container.sh"]
