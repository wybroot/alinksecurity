# ==============================================================================
# AlinkSec Verification & CI Sandbox Container
# 纯 Linux 沙盒验证容器，宿主机杀毒软件零接触、零误杀
# ==============================================================================
FROM golang:1.22-alpine

WORKDIR /app

# 替换 Alpine 国内加速源，安装基础工具 (若断网则优雅跳过，内置 /bin/sh 原生支持)
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories || true

# 预置 Go 代理加速
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=0

# 拷贝代码依赖
COPY go.mod go.sum ./
RUN go mod download

# 拷贝全部源码
COPY . .

# 赋予执行权限并转换换行符 (CRLF -> LF)
RUN tr -d '\r' < scripts/verify_in_container.sh > scripts/verify_in_container_lf.sh && \
    mv scripts/verify_in_container_lf.sh scripts/verify_in_container.sh && \
    chmod +x scripts/*.sh

# 默认运行容器内端到端全量验证
CMD ["/bin/sh", "scripts/verify_in_container.sh"]
